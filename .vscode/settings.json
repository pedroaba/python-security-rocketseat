{
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "driver": "SQLite",
      "name": "sqlite_security_course",
      "database": "./storage.db"
    }
  ],
  "python.linting.enabled": false,
  "python.linting.pylintEnabled": false,
  "files.exclude": {
    "**/*.pyc": {"when": "$(basename).py"},
    "**/__pycache__": true,
    "**/*.pytest_cache": true
  }
}